;system wayfinder notes - see `man way` or `way help`
{
 :search-keys ["wayf-dev"]
 :direntry-note "Welcome to the system wayfinder project"
 :usage-reminders {:bbtest ["Testing with Babashka" 
                            "bb -m way.main notecheck"
                            "bb -m way.main show"
			    ]
		   :bbrepl ["Starting the repl" "make nrepl"]
		   :touch  ["Make note active again" "touch -d yesterday .wayf"]
                   }
  :commands       {:lsr   "ls /"
                   :ls    "asdfasdfsdasdf"
		   :touch "touch -d yesterday .wayf"
		   :vimt  "vim ~/.init.vim"}
  :reminders      ["Clean up something something"]
}
